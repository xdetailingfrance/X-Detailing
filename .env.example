# Base PostgreSQL (OBLIGATOIRE). Une base distincte pour les tests, dont
# le nom contient « test » (npm test la vide).
DATABASE_URL="postgresql://user:password@localhost:5432/xdetailing?schema=public"

# Authentification réelle, OBLIGATOIRE en production (sinon le back-office
# s'ouvre sans mot de passe). Nécessite SESSION_SECRET ci-dessous.
# DISABLE_AUTH="false"

# Secret de signature des sessions réelles (générer avec: openssl rand -hex 32).
# Utile uniquement quand DISABLE_AUTH=false.
# SESSION_SECRET="changez-moi-en-une-valeur-aleatoire-longue"

# Optionnel : donne à l'assistante vocale Lola (écran d'accueil /back-office)
# l'intelligence de Claude : réponses libres sur tout X Detailing ET actions
# (mettre des RDV au planning, affecter des opérateurs, envoyer des SMS...).
# Sans clé, Lola lit seulement le planning avec son moteur intégré.
# ANTHROPIC_API_KEY="sk-ant-..."

# Optionnel : envoi RÉEL des SMS via Twilio. Sans ces trois variables, les SMS
# sont simulés (visibles dans /back-office/sms, pas envoyés).
# TWILIO_ACCOUNT_SID="AC..."
# TWILIO_AUTH_TOKEN="..."
# TWILIO_FROM="+33..."   # numéro ou identifiant d'expéditeur Twilio

# Optionnel : active les rappels SMS automatiques de la veille (Vercel Cron,
# voir vercel.json). Vercel l'envoie en en-tête Authorization.
# CRON_SECRET="une-valeur-aleatoire-longue"

# Optionnel : paiement de l'acompte (10 %) des réservations en ligne par
# Stripe Checkout. Sans clé, la réservation est enregistrée sans paiement en
# ligne. Avec la clé, rien n'est confirmé avant la validation du paiement par
# Stripe. Redéployer après l'ajout (la page d'accueil est générée au build).
# STRIPE_SECRET_KEY="sk_live_..."      # ou sk_test_... pour essayer
# Webhook Stripe → https://<votre-domaine>/api/stripe/webhook, événements :
# checkout.session.completed, checkout.session.async_payment_succeeded,
# checkout.session.expired
# STRIPE_WEBHOOK_SECRET="whsec_..."

# Premier compte directeur, créé au déploiement (npm run vercel-build) si
# aucun directeur n'existe encore. Sans effet ensuite : un compte existant
# n'est jamais modifié. Mot de passe de 12 caractères minimum.
# DIRECTEUR_EMAIL="vous@exemple.fr"
# DIRECTEUR_MOT_DE_PASSE="..."

# Facultatif : range toutes les tables dans un schéma PostgreSQL dédié
# (ex. « backoffice ») pour partager une base avec une autre application
# sans toucher à ses tables.
# DATABASE_SCHEMA="backoffice"

