{
    "name": "x-detailing-os",
    "version": "0.1.0",
    "private": true,
    "scripts": {
      "dev": "next dev",
      "build": "prisma generate && next build",
      "start": "next start",
      "lint": "eslint",
      "test": "TZ=UTC node --import tsx --test --test-concurrency=1 tests/*.test.ts",
      "postinstall": "prisma generate",
      "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:catalogue": "tsx prisma/seed.ts catalogue",
    "db:demo": "tsx prisma/seed.ts demo",
    "db:demo:supprimer": "tsx prisma/seed.ts supprimer-demo",
    "db:studio": "prisma studio",
    "creer-utilisateur": "tsx scripts/creer-utilisateur.ts",
    "vercel-build": "prisma generate && prisma migrate deploy && tsx prisma/seed.ts catalogue && tsx scripts/premier-directeur.ts && next build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.12",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "stripe": "^23.0.1"
  },
  "devDependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7.10.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "pg": "^8.23.0",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}

