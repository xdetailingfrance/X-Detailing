# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# Photos stockées localement (§13) — données personnelles, jamais versionnées
/.data

# Outillage local de l'éditeur. `.claude/skills/` ne contient que des liens
# symboliques vers `.agents/`, absent du dépôt : les versionner livrerait des
# liens cassés — et c'est déjà ce qui avait fait échouer un déploiement.
/.claude
/.agents
skills-lock.json

# Doublons créés par la synchronisation iCloud (« fichier 2.ts »). Ils cassent
# la compilation en redéclarant les mêmes identifiants.
*\ 2.ts
*\ 2.tsx
*\ 2.json
